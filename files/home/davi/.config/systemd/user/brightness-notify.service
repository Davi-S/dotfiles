[Unit]
Description=Brightness change notifications
# This unit will stop if the graphical session ends
PartOf=graphical-session.target
# This unit will only start after the graphical session is ready
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/bin/brightness-notify-daemon
Restart=on-failure
RestartSec=2
# Place it in the background slice for better resource management
Slice=background-graphical.slice

[Install]
# Start this unit automatically when the graphical session starts
WantedBy=graphical-session.target
