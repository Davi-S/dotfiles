#!/usr/bin/env bash

# Caffeine
# ========
# A Script to Simulate the "Caffeine" Program Behavior
#
# This script temporarily disables the hypridle service (which manages
# automatic idle timeouts) for a specified period and then re-enables it
# once the timer expires. It's similar to the "caffeine" program that 
# prevents the screen from dimming or the system from going idle.
#
# Usage:
#     $0 <time_in_minutes>: The duration in minutes to keep hypridle disabled.
#                           If the value is "0", hypridle will be re-enabled immediately.
#
# Functionality:
#     - Stops the hypridle service (disables idle actions).
#     - Cancels any previously scheduled reactivation of hypridle.
#     - Schedules a reactivation of hypridle after the specified time.
#     - If "0" is passed, it re-enables hypridle immediately, canceling any scheduled timers.
#
# Dependencies:
#     - systemctl (for controlling the hypridle service and timers)
#     - systemd-run (for scheduling reactivation)
#
# Example:
#     To disable hypridle for 10 minutes:
#       $ caffeine 10
#     To immediately re-enable hypridle:
#       $ caffeine 0
#
# Notes:
#     - This script uses systemd timers to handle the reactivation of hypridle.
# ========
### END USAGE

SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

# Import helper functions
source "$SCRIPT_DIR/utils.sh"

# Check for help flag
check_help_flag "$@"

# Validate argument
if [[ -z "$1" || ! "$1" =~ ^[0-9]+$ ]]; then
    echo "Invalid or missing argument."
    echo "Run with --help to see usage."
    exit 1
fi

# Cancel previously scheduled reactivation if exists
cancel_timer() {
    if systemctl --user is-active --quiet restart-hypridle.timer; then
        echo "Canceling previously scheduled reactivation."
        systemctl --user stop restart-hypridle.timer
    else
        echo "No previous scheduled reactivation to cancel."
    fi
}

# Stop hypridle service if it's running
stop_hypridle() {
    if systemctl --user is-active --quiet hypridle.service; then
        echo "Hypridle is active. Stopping it..."
        systemctl --user stop hypridle.service
    else 
        echo "Hypridle is already stopped."
    fi 
}

# Start hypridle service if it's not running
start_hypridle() {
    if systemctl --user is-active --quiet hypridle.service; then
        echo "Hypridle is alredy active."
    else
        echo "Hypridle is stopped. Starting it..."
        systemctl --user start hypridle.service
    fi
}

# Disable caffeine (re-enable hypridle immediately)
if [[ "$1" == "0" ]]; then
    cancel_timer
    start_hypridle
    notify-send -t 2000 "Caffeine" "Caffeine disabled. Hypridle is running."
else
    stop_hypridle
    cancel_timer
    echo "Scheduling Hypridle reactivation in ${1} minutes..."
    systemd-run --user --on-active="${1}m" --unit=restart-hypridle.service systemctl --user start hypridle.service
    notify-send -t 2000 "Caffeine" "Hypridle disabled for $1 minutes."
fi

echo "Done."
