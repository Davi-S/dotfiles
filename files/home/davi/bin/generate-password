#!/bin/bash

# Ensure exactly two arguments are provided
if [ "$#" -ne 2 ]; then
    echo "Usage: generate-password <master_password> <salt>"
    exit 1
fi

# Hash the salt to guarantee a long enough salt
salt=$(printf '%s' "$2" | sha256sum | awk '{print $1}')

# Generate the argon2 hash
hash=$(printf '%s' "$1" | argon2 "$salt" -id -v 13 -t $((2 ** 2)) -k $((2 ** 20)) -p $((2 ** 2)) -l 32 -r) ||
    {
        echo "argon2 failed" >&2
        exit 1
    }

# Verify the expected length
[ "${#hash}" -eq 64 ] || {
    echo "unexpected hash length" >&2
    exit 1
}

# 1. Uppercase hex (because the basenc needs it uppercase)
# 2. Raw bytes (so the encoded password carries the whole 256 bits)
# 3. z85 (so we get special characters, number, uppercase, and lowercase)
printf '%s' "${hash^^}" | basenc --base16 -d | basenc --z85 -w 0

# Test to verify integrity:
#
# master_password = "masterpassword"
# salt =            "longsalt"
# result =          "{*!AdeSwnV>wj#GVz:W>>zY+gSZb6mrm3<FO=CMj"
