#!/usr/bin/env bash

# Volume Control
# ==============
# A utility script to manage audio volume and mute status using wpctl.
# Volume is handled in whole percentages relative to MAX_VOLUME (see utils.sh),
# so steps are always clean (e.g. 45% -> 50%) and the volume never goes past it.
# This script only changes the volume: notifications are sent by
# volume-notify-daemon whenever the volume changes, whatever changed it.
#
# Usage:
#     $0 <action>
#
# Actions:
#     +<amount>   - Increase volume by amount% (e.g., +5)
#     -<amount>   - Decrease volume by amount% (e.g., -5)
#     <amount>    - Set volume to absolute percentage (e.g., 50)
#     toggle      - Toggle mute status
#     mute        - Force mute
#     unmute      - Force unmute
#
# Examples:
#     $0 +5       # Increase by 5%
#     $0 50       # Set volume to 50% (of MAX_VOLUME)
#     $0 unmute   # Force unmute
#
# Notes:
#     - Requires `wpctl`
# ==========================
### END USAGE

SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
source "$SCRIPT_DIR/utils.sh"
check_help_flag "$@"

SINK="@DEFAULT_AUDIO_SINK@"

case "$1" in
    toggle) wpctl set-mute "$SINK" toggle ;;
    mute)   wpctl set-mute "$SINK" 1 ;;
    unmute) wpctl set-mute "$SINK" 0 ;;
    *)
        if ! TARGET=$(target_percentage "$(volume_percentage "$SINK")" "$1"); then
            echo "Error: Invalid argument '$1'"
            echo "Try '$0 --help' for usage."
            exit 1
        fi
        # Convert the percentage of MAX_VOLUME to wpctl's volume (1.0 = 100%)
        wpctl set-volume "$SINK" "$(awk -v pct="$TARGET" -v max="$MAX_VOLUME" 'BEGIN { print (pct / 100) * max }')"
        ;;
esac
