#!/usr/bin/env bash

# Phone Automount
# ===============
# A utility script to handle MTP mounting for your phone.
#
# Usage:
#     $0 <action>
#
# Actions:
#     add       - Mount the phone via simple-mtpfs
#     remove    - Unmount the phone safely
#
# Notes:
#     - Requires `simple-mtpfs` and `fusermount`.
# ==========================
### END USAGE

SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
source "$SCRIPT_DIR/utils.sh"
check_help_flag "$@"

ACTION="$1"
MOUNT_POINT="/home/davi/Phone"

# Ensure correct DBus session for notifications
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u davi)/bus"

case "$ACTION" in
add)
    mkdir -p "$MOUNT_POINT"
    sleep 1 # Give the phone a second to initialize MTP
    if simple-mtpfs "$MOUNT_POINT"; then
        notify-send -t 1000 "MTP Mount" "Phone mounted at $MOUNT_POINT"
    else
        notify-send -t 1000 "MTP Mount" "Failed to mount"
        exit 1
    fi
    ;;
remove)
    if fusermount -uz "$MOUNT_POINT"; then
        notify-send -t 1000 "MTP Mount" "Phone unmounted safely"
    fi
    ;;
*)
    echo "Error: Invalid argument '$ACTION'"
    echo "Try '$0 --help' for usage."
    exit 1
    ;;
esac
