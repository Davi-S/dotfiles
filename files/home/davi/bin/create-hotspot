#!/usr/bin/env bash

# Create Hotspot
# ===============
# Creates a Wi-Fi hotspot using NetworkManager, allowing other devices
# to share the current Ethernet connection. This is similar to sharing
# mobile data with a phone.
#
# Usage:
#     $0 <SSID> <Password>
#
# Arguments:
#     <SSID>      Name of the hotspot network (required)
#     <Password>  WPA2 password for the hotspot (required)
#
# Behavior:
#     - Fails if the Wi-Fi interface isn't found
#     - Fails if a hotspot profile with the same SSID already exists
#     - Creates a new Wi-Fi hotspot with NAT sharing enabled
#
# Notes:
#     - Update the IFNAME variable to match your Wi-Fi interface name
# =============== 
### END USAGE

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

# Source the helper functions
source "$SCRIPT_DIR/utils.sh"

# Check for the help flag to show the usage
check_help_flag "$@"

# === Password Validation Function ===
validate_password() {
    local password="$1"
    local min_length=8

    if [[ ${#password} -lt $min_length ]]; then
        echo "Error: Password must be at least $min_length characters long."
        return 1
    fi

    # Optional: Add more checks (e.g., no spaces, special chars, etc.)
    if [[ "$password" =~ [[:space:]] ]]; then
        echo "Error: Password cannot contain spaces."
        return 1
    fi

    return 0
}

# ===== Argument validation =====
if [[ $# -ne 2 ]]; then
    echo "Usage: $0 <SSID> <Password>"
    exit 1
fi

# === Password Check ===
if ! validate_password "$2"; then
    exit 1
fi

# ===== Configuration =====
IFNAME="wlp4s0"  # Replace with your Wi-Fi interface name

SSID="$1"
PASSWORD="$2"
CON_NAME="${SSID// /_}"  # Convert spaces to underscores for profile name

# ===== Interface check =====
if ! nmcli device status | grep -q "^$IFNAME"; then
    echo "Error: Wi-Fi interface '$IFNAME' not found."
    exit 1
fi

# ===== Check for duplicate connection =====
if nmcli connection show | grep -q "$CON_NAME"; then
    echo "Error: A connection profile named '$CON_NAME' already exists."
    exit 1
fi

# ===== Create and configure the hotspot =====
#echo "Creating hotspot '$SSID'..."

# "autoconnect yes" will start the hotspot when the wifi interface is readdy (on boot)
#nmcli connection add type wifi ifname "$IFNAME" con-name "$CON_NAME" autoconnect yes ssid "$SSID"
# "a" means 5 GHz band, "bg" means 2.5 GHz band. 5 GHz was rasing a timeout error when trying to start the hotspot, so here I'm using 2.5 GHz
# nmcli connection modify "$CON_NAME" 802-11-wireless.mode ap 802-11-wireless.band a
#nmcli connection modify "$CON_NAME" 802-11-wireless.mode ap 802-11-wireless.band bg
#nmcli connection modify "$CON_NAME" wifi-sec.key-mgmt wpa-psk
#nmcli connection modify "$CON_NAME" wifi-sec.psk "$PASSWORD"
#nmcli connection modify "$CON_NAME" ipv4.method shared
#nmcli connection modify "$CON_NAME" ipv6.method shared

# ===== Start hotspot =====
#echo "Starting hotspot '$SSID'..."
#if nmcli connection up "$CON_NAME"; then
#    echo "Hotspot '$SSID' is now active!"
#else
#    echo "Failed to activate hotspot '$SSID'."
#    exit 1
#fi

# ===== Create and start the hotspot =====
echo "Creating and starting hotspot '$SSID'..."

if nmcli device wifi hotspot ifname "$IFNAME" con-name "$CON_NAME" ssid "$SSID" password "$PASSWORD" band a; then
    echo "Hotspot '$SSID' is now active!"
    echo "To turn it off, run: nmcli connection down '$CON_NAME'"
else
    echo "Failed to create hotspot '$SSID'."
    # Clean up failed profile
    nmcli connection delete "$CON_NAME" &>/dev/null
    exit 1
fi
