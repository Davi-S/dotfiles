# Hostinger account behind studiocolosso.com, dev. and amostra.
# The key is the GitHub Actions deploy key (repo secret SSH_PRIVATE_KEY).
# The server's host key is in ~/.ssh/known_hosts, the same one CI pins
# (repo secret SSH_KNOWN_HOSTS). That file is root-owned on purpose, so a
# changed host key is refused rather than silently re-learned.
Host colosso-hostinger
    HostName 185.211.7.74
    Port 65002
    User u429672069
    IdentityFile ~/.ssh/colosso_deploy
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    # Otherwise ssh tries to add the server's other key types to the
    # read-only known_hosts on every connection and prints two errors.
    UpdateHostKeys no
